/tools/preview-cost/dist

# Test output
/test-results
/playwright-report
/blob-report
/playwright/.cache
/coverage

# Agent worktrees created by Claude Code
.claude/worktrees/

# Playwright MCP session logs and page snapshots
.playwright-mcp/

# Claude Code session state
.claude/

# Screenshots from design and verification runs. Agents produce these at the
# repo root; they are review artefacts, not source.
*.png
*.jpg
*.jpeg
*.webp
!static/**/*.png
!static/**/*.jpg
!src/**/*.png

# Review evidence. An agent that redesigns something is required to look at its own
# work (AGENTS.md), and a screenshot nobody can see is not evidence. Committing them
# here is the only way to put one in front of a reviewer, since there is no API for
# attaching an image to a pull request. Keep them small and delete stale ones.
!docs/screenshots/
!docs/screenshots/**/*.png
!src/**/*.jpg
