{
	"name": "flights",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"data:airports": "node scripts/prepare-airports.mjs",
		"data:flags": "node scripts/prepare-flags.mjs",
		"data:icons": "node scripts/prepare-icons.mjs",
		"data:city-centres": "node scripts/prepare-city-centres.mjs",
		"data:coastline": "node scripts/prepare-coastline.mjs",
		"data:cheap-routes": "node scripts/fetch-cheap-routes.mjs",
		"data:ryanair-network": "node scripts/fetch-ryanair-network.mjs",
		"test:e2e": "playwright test --grep-invert \"@live|@screenshot\"",
		"test:e2e:live": "ALLOW_LIVE_TESTS=1 playwright test --grep @live",
		"test:e2e:report": "playwright show-report",
		"qa": "playwright test --config qa.config.ts",
		"qa:live": "QA_LIVE=1 playwright test --config qa.config.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tabler/icons": "3.46.0",
		"@types/node": "^26.4.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"circle-flags": "2.8.3",
		"eslint": "^10.9.1",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.4",
		"sirv": "^3.0.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"maplibre-gl": "^6.7.0"
	}
}
